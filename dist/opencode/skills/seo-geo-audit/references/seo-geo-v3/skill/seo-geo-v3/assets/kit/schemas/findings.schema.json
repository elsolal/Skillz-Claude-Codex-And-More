{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.seo-geo.invalid/seo-geo/v3/findings.schema.json",
  "title": "SEO/GEO V3 findings registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "generated_at", "findings"],
  "properties": {
    "schema_version": {"const": "3.0"}, "audit_id": {"type": "string", "pattern": "^audit_"}, "generated_at": {"type": "string", "format": "date-time"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "title", "category", "dimension", "statement", "impact", "severity", "confidence", "basis", "evidence_ids", "status", "detected_at"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^finding_[a-z0-9][a-z0-9_-]{2,95}$"},
          "title": {"type": "string", "minLength": 3},
          "category": {"enum": ["technical", "content", "entity", "authority", "local", "ai_visibility", "measurement", "conversion", "governance"]},
          "dimension": {"enum": ["F", "V", "O", "E", "M"]},
          "issue_type": {"type": "string"},
          "statement": {"type": "string", "minLength": 10},
          "impact": {"type": "string", "minLength": 5},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "confidence": {"enum": ["confirmed", "strong", "moderate", "weak"]},
          "basis": {"enum": ["observed", "proxy", "client_reported", "inferred"]},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_"}},
          "fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^fact_"}},
          "affected_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
          "status": {"enum": ["open", "accepted", "in_progress", "resolved", "dismissed", "blocked"]},
          "detected_at": {"type": "string", "format": "date-time"},
          "metric": {"type": "object"},
          "rule_id": {"type": ["string", "null"]},
          "supersedes_id": {"type": ["string", "null"], "pattern": "^finding_"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
