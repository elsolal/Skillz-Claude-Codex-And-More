{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.seo-geo.invalid/seo-geo/v3/actions.schema.json",
  "title": "SEO/GEO V3 action registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "generated_at", "actions"],
  "properties": {
    "schema_version": {"const": "3.0"}, "audit_id": {"type": "string", "pattern": "^audit_"}, "generated_at": {"type": "string", "format": "date-time"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action_id", "title", "description", "finding_ids", "stream", "priority", "status", "effort", "impact", "confidence", "owner", "dependencies", "preconditions", "procedure", "acceptance_criteria", "validation_method", "risk", "backup", "rollback", "approval_required", "automation"],
        "properties": {
          "action_id": {"type": "string", "pattern": "^action_[a-z0-9][a-z0-9_-]{2,95}$"},
          "title": {"type": "string", "minLength": 3}, "description": {"type": "string", "minLength": 10},
          "finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^finding_"}},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_"}},
          "stream": {"enum": ["audit", "build", "grow", "monitor"]}, "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "status": {"enum": ["backlog", "ready", "in_progress", "in_review", "done", "blocked", "cancelled"]},
          "effort": {"type": "object", "additionalProperties": false, "required": ["size"], "properties": {"size": {"enum": ["XS", "S", "M", "L", "XL"]}, "person_days": {"type": ["number", "null"], "minimum": 0}}},
          "impact": {"enum": ["very_high", "high", "medium", "low"]}, "confidence": {"enum": ["confirmed", "strong", "moderate", "weak"]}, "owner": {"type": ["string", "null"]},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^action_"}},
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
          "validation_method": {"type": "string", "minLength": 5}, "rollback": {"type": "string", "minLength": 5},
          "due_date": {"type": ["string", "null"], "format": "date"}, "target_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
          "risk": {"enum": ["high", "medium", "low"]}, "approval_required": {"type": "boolean"}, "automation": {"enum": ["manual", "assisted", "automated"]},
          "preconditions": {"type": "array", "items": {"type": "string", "minLength": 3}},
          "procedure": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "backup": {"type": "string", "minLength": 5},
          "supersedes_id": {"type": ["string", "null"], "pattern": "^action_"},
          "progress_notes": {"type": "string"}
        }
      }
    }
  }
}
