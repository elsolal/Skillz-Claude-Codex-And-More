{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.seo-geo.invalid/seo-geo/v3/audit_manifest.schema.json",
  "title": "SEO/GEO V3 audit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "client_id", "created_at", "updated_at", "status", "scope", "authorization", "data_policy", "methodology", "outputs"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "audit_id": {"type": "string", "pattern": "^audit_[a-z0-9][a-z0-9_-]{2,63}$"},
    "client_id": {"type": "string", "pattern": "^client_[a-z0-9][a-z0-9_-]{2,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["planned", "collecting", "analyzing", "qa_ready", "complete", "paused", "cancelled"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "root_url", "locales", "markets", "vertical", "max_pages", "expected_checks"],
      "properties": {
        "mode": {"enum": ["full", "express", "single_page", "delta", "monitor", "content", "implementation", "international"]},
        "root_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "locales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"}},
        "markets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "vertical": {"enum": ["local", "b2b", "saas", "ecommerce", "publisher", "ymyl", "personal_brand", "other"]},
        "max_pages": {"type": "integer", "minimum": 1, "maximum": 200},
        "include_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "exclude_patterns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$"}},
        "measurement_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_by", "authorized_at", "permissions", "write_actions_require_approval"],
      "properties": {
        "authorized_by": {"type": "string", "minLength": 2},
        "authorized_at": {"type": ["string", "null"], "format": "date-time"},
        "permissions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["public_web", "read_gsc", "read_ga4", "read_bing", "read_gbp", "read_logs", "read_crm", "write_cms", "write_external"]}
        },
        "write_actions_require_approval": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_days", "pii", "secrets", "client_isolation"],
      "properties": {
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 3650},
        "pii": {"enum": ["forbidden", "minimized", "authorized"]},
        "secrets": {"enum": ["not_stored", "reference_only", "vault"]},
        "client_isolation": {"const": true},
        "deletion_contact": {"type": "string"}
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kit_version", "schema_version", "rules_snapshot_date", "scoring_version"],
      "properties": {
        "kit_version": {"type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+$"},
        "schema_version": {"const": "3.0"},
        "rules_snapshot_date": {"type": "string", "format": "date"},
        "scoring_version": {"const": "3.0"},
        "notes": {"type": "string"}
      }
    },
    "run_ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collector": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "geo": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blind_spots": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
