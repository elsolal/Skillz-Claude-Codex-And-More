{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roso.ai/seo-geo/v3/geo_run.schema.json",
  "title": "RosoAI V3 reproducible GEO run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "audit_id", "started_at", "completed_at", "engine", "model", "surface", "locale", "country", "device", "account_state", "personalization", "web_access", "session", "panel_version", "planned_prompt_ids", "repeat_index", "total_repeats", "brand", "observations"],
  "properties": {
    "schema_version": {"const": "3.0"}, "run_id": {"type": "string", "pattern": "^geo_[a-z0-9][a-z0-9_-]{2,95}$"}, "audit_id": {"type": "string", "pattern": "^audit_"},
    "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"},
    "engine": {"enum": ["chatgpt", "perplexity", "gemini", "claude", "google_ai_overviews", "bing_copilot", "other"]},
    "model": {"type": "string", "minLength": 1}, "surface": {"type": "string", "minLength": 1}, "locale": {"type": "string"}, "country": {"type": "string"},
    "device": {"enum": ["desktop", "mobile", "other"]}, "account_state": {"enum": ["clean", "authenticated", "unknown"]}, "personalization": {"enum": ["off", "on", "unknown"]}, "web_access": {"enum": ["on", "off", "unknown"]},
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "context_state", "client_material_exposure", "documentation_status"],
      "properties": {
        "session_id": {"type": "string", "pattern": "^session_[a-z0-9][a-z0-9_-]{2,95}$"},
        "context_state": {"enum": ["new", "cleared", "continuing", "unknown"]},
        "client_material_exposure": {"enum": ["none", "prompt_supplied", "memory_or_history", "unknown"]},
        "documentation_status": {"enum": ["complete", "partial", "unavailable"]},
        "notes": {"type": "string"}
      }
    },
    "panel_version": {"type": "string", "minLength": 1},
    "planned_prompt_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^prompt_[a-z0-9][a-z0-9_-]{2,95}$"}},
    "repeat_index": {"type": "integer", "minimum": 1}, "total_repeats": {"type": "integer", "minimum": 1},
    "brand": {"type": "object", "additionalProperties": false, "required": ["name", "domain"], "properties": {"name": {"type": "string"}, "domain": {"type": "string"}, "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "observations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "anyOf": [
          {"required": ["response_hash"], "properties": {"response_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
          {"required": ["evidence_id"], "properties": {"evidence_id": {"type": "string", "pattern": "^ev_[a-z0-9][a-z0-9_-]{2,95}$"}}}
        ],
        "required": ["prompt_id", "prompt_text", "prompt_origin", "persona", "criticality", "intent", "funnel_stage", "query_type", "response_status", "brand_mentioned", "recommendation_status", "citations", "claims", "sentiment", "captured_at"],
        "properties": {
          "prompt_id": {"type": "string", "pattern": "^prompt_[a-z0-9][a-z0-9_-]{2,95}$"}, "prompt_text": {"type": "string", "minLength": 3},
          "prompt_origin": {
            "type": "object", "additionalProperties": false, "required": ["type", "reference"],
            "properties": {
              "type": {"enum": ["first_party_data", "search_observation", "customer_research", "synthetic_hypothesis", "editorial_research", "other"]},
              "reference": {"type": ["string", "null"]}
            }
          },
          "persona": {"type": "string", "minLength": 1},
          "criticality": {"enum": ["critical", "high", "medium", "low"]},
          "intent": {"enum": ["informational", "commercial", "transactional", "navigational", "local"]}, "funnel_stage": {"enum": ["awareness", "consideration", "decision", "retention"]},
          "query_type": {"enum": ["unbranded", "branded", "comparative"]}, "response_status": {"enum": ["ok", "refused", "error", "not_available"]},
          "brand_mentioned": {"type": "boolean"}, "brand_position": {"type": ["integer", "null"], "minimum": 1},
          "recommendation_status": {"enum": ["positive", "neutral", "negative", "brand_absent", "not_applicable", "not_assessed"]},
          "competitors_mentioned": {"type": "array", "items": {"type": "string"}},
          "citations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["url", "domain", "is_brand"], "properties": {"url": {"type": "string", "format": "uri"}, "domain": {"type": "string"}, "title": {"type": "string"}, "is_brand": {"type": "boolean"}}}},
          "claims": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["fact_key", "status"], "properties": {"fact_key": {"type": "string"}, "status": {"enum": ["accurate", "inaccurate", "outdated", "unverifiable"]}, "notes": {"type": "string"}}}},
          "sentiment": {"enum": ["positive", "neutral", "negative", "mixed", "unrated"]}, "response_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
          "evidence_id": {"type": ["string", "null"], "pattern": "^ev_"}, "captured_at": {"type": "string", "format": "date-time"}, "notes": {"type": "string"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
