{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roso.ai/seo-geo/v3/evidence.schema.json",
  "title": "RosoAI V3 evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "audit_id", "collected_at", "source_type", "method", "status", "confidence", "collector"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "evidence_id": {"type": "string", "pattern": "^ev_[a-z0-9][a-z0-9_-]{2,95}$"},
    "supersedes_id": {"type": ["string", "null"], "pattern": "^ev_[a-z0-9][a-z0-9_-]{2,95}$"},
    "audit_id": {"type": "string", "pattern": "^audit_"},
    "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$"},
    "collected_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "source_type": {"enum": ["web_page", "robots", "sitemap", "search_console", "ga4", "bing_webmaster", "gbp", "crm", "log_file", "ai_response", "client_input", "manual_observation", "third_party_tool", "api"]},
    "method": {"enum": ["http_get", "api_import", "file_import", "user_declaration", "manual_review", "ai_test", "browser_capture"]},
    "url": {"type": ["string", "null"], "format": "uri"},
    "source_label": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": {"type": "string"}, "market": {"type": "string"}, "device": {"enum": ["desktop", "mobile", "other", "unknown"]},
        "account_state": {"enum": ["clean", "authenticated", "unknown"]}, "model": {"type": "string"}, "surface": {"type": "string"}, "user_agent": {"type": "string"}
      }
    },
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "content_type": {"type": "string"},
    "title": {"type": "string"},
    "extract": {"type": "string", "maxLength": 5000},
    "observation": {"type": "string", "maxLength": 10000},
    "raw_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "raw_path": {"type": ["string", "null"]},
    "status": {"enum": ["observed", "proxy", "client_reported", "inferred", "not_measured", "unknown"]},
    "confidence": {"enum": ["confirmed", "strong", "moderate", "weak"]},
    "collector": {"type": "string", "minLength": 2},
    "authorization_permission": {"enum": ["public_web", "read_gsc", "read_ga4", "read_bing", "read_gbp", "read_logs", "read_crm"]},
    "metadata": {"type": "object"}
  },
  "anyOf": [
    {"required": ["url"], "properties": {"url": {"type": "string", "format": "uri"}}},
    {"required": ["source_label"], "properties": {"source_label": {"type": "string", "minLength": 1}}},
    {"required": ["observation"], "properties": {"observation": {"type": "string", "minLength": 1}}}
  ]
}
